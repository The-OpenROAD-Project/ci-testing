# Knobs for ci/check.sh, sourced by BOTH GitHub Actions and Jenkins.
#
# Because this file is versioned, a PR that edits it changes CI behaviour for
# that PR (and for any merge-queue branch containing it) only. That is how the
# test scenarios in README.md are driven.

# Fail if items/*.txt count exceeds this. Drives the semantic-conflict test:
# two PRs that each add one item pass alone and fail once batched together.
#
# Raised from 2 to 8 after scenario 4 proved the point — at 2, every subsequent
# item PR fails on count and the batching/eviction scenarios cannot be read.
# To replay scenario 4, set it on the PR branches to (current item count + 1)
# rather than lowering it on main.
MAX_ITEMS=3

# Padding so several PRs can be queued while the first is still building.
# Set to 0 for local runs.
SLEEP_SECONDS=60

# 1 = always fail, on PR and in the queue.
FORCE_FAIL=0

# 1 = fail ONLY on a merge-queue ref. Green PR, red queue entry: the cleanest
# way to test eviction of a single PR without a semantic conflict.
QUEUE_ONLY_FAIL=0
